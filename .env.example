# MongoDB
MONGO_URI=mongodb://localhost:27017/carparts
# Or with auth: mongodb://admin:password@localhost:27017/carparts?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Zarinpal Merchant ID (empty if not using gateway)
ZARINPAL_MERCHANT_ID=

# Frontend API URL — Next.js rewrites /api/* here
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Uploads public URL — must be the public domain where nginx serves uploads
# PRODUCTION: set to your site URL (e.g. https://pickyadak.ir)
# Images will load as <img src="https://pickyadak.ir/uploads/..."> via nginx → Express
# Leave empty if you don't need absolute URLs (relative paths will be used)
NEXT_PUBLIC_UPLOADS_URL=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PORT
PORT=5000